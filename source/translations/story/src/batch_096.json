  {
   "id": 16206,
   "src": "パズルかんかくで\nか~んた~ん カスタマイズ!\nたのしいですよね~",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    13
   ],
   "uses": 2
  },
  {
   "id": 16207,
   "src": "ちなみに みなさんは\nどんなカスタマイズ\nされてるんですか?",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    13
   ],
   "uses": 2
  },
  {
   "id": 16208,
   "src": "ぼくは オペレートがヘタで\nすぐにナビが デリート\nされるんです",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    14
   ],
   "uses": 2
  },
  {
   "id": 16209,
   "src": "そこで 「HP+200」と\n「セルフリカバリー」で",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    14
   ],
   "uses": 2
  },
  {
   "id": 16210,
   "src": "すぐにデリートされない\nタフなナビにカスタマイズしました",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    14
   ],
   "uses": 2
  },
  {
   "id": 16211,
   "src": "ちなみに このプログラムは\nオラン島エリア3の\nショップでこうにゅう",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    14
   ],
   "uses": 2
  },
  {
   "id": 16212,
   "src": "オススメです!\nこんど かんこうがてらに\n行ってみてはどうですか?",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    14
   ],
   "uses": 2
  },
  {
   "id": 16213,
   "src": "オレは じぶんのフォルダを\n電気ビリビリフォルダにしたくて\n電気属性のチップをあつめてるんだ",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    15
   ],
   "uses": 2
  },
  {
   "id": 16214,
   "src": "そういうときには\n「バッテリーモード」 って\nプログラムの でばんだぜ!",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    15
   ],
   "uses": 2
  },
  {
   "id": 16215,
   "src": "これを ナビカスにくみこめば\n電気属性のウイルスが\nよってくるようになるんだ",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    15
   ],
   "uses": 2
  },
  {
   "id": 16216,
   "src": "ナビカスは ナビのせいのうを\nアップさせるだけじゃないぜ",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    15
   ],
   "uses": 2
  },
  {
   "id": 16217,
   "src": "やあ!\nナビカスも バッチリな\nコーエツにいさんだよ",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    16
   ],
   "uses": 2
  },
  {
   "id": 16218,
   "src": "トキタダくんのいうとおりだね\nナビカスは ナビきょうかだけが\nもくてきではないんだ",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    16
   ],
   "uses": 2
  },
  {
   "id": 16219,
   "src": "じぶんの もくてきにあわせた\nカスタマイズをすることが",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    16
   ],
   "uses": 2
  },
  {
   "id": 16220,
   "src": "ナビカスマスターへの\nだいいっぽと いえるね",
   "speakers": [],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "07E17DC",
    16
   ],
   "uses": 2
  }
 ]
}
