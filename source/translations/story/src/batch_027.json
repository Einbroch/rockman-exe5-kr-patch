   "src": "いったコトも おぼえてないし\n前後のキオクも あいまいなの",
   "speakers": [
    "SciLabWoman"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    42
   ],
   "uses": 2
  },
  {
   "id": 5610,
   "src": "とんでもなく ひどいコトを\nいったような 気がするよ",
   "speakers": [
    "BusinessMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    43
   ],
   "uses": 2
  },
  {
   "id": 5611,
   "src": "コレからの しごとに\nひびかなければ\nいいんだけどな・・・",
   "speakers": [
    "BusinessMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    43
   ],
   "uses": 2
  },
  {
   "id": 5612,
   "src": "ダメだ・・・",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    44
   ],
   "uses": 2
  },
  {
   "id": 5613,
   "src": "いしきが とおくなった後は、\nなにを いって なにをいわれたか\nまったく キオクにないよ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    44
   ],
   "uses": 2
  },
  {
   "id": 5614,
   "src": "かならず ネビュラを\nぶっつぶして きてください",
   "speakers": [
    "SciLabYoungMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    50
   ],
   "uses": 2
  },
  {
   "id": 5615,
   "src": "いわゆる\n「かんぜんげきは」\nですネ!",
   "speakers": [
    "SciLabYoungMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    50
   ],
   "uses": 2
  },
  {
   "id": 5616,
   "src": "グッドラック!",
   "speakers": [
    "SciLabYoungMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    50
   ],
   "uses": 2
  },
  {
   "id": 5617,
   "src": "キミたちが いない間、\nコッチで なにも おきないよう\nわれわれも がんばるよ",
   "speakers": [
    "SciLabMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    51
   ],
   "uses": 2
  },
  {
   "id": 5618,
   "src": "だから キミは ネビュラを\nたおすことだけを かんがえてくれ\nわかったね?",
   "speakers": [
    "SciLabMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    51
   ],
   "uses": 2
  },
  {
   "id": 5619,
   "src": "ネビュラの やぼうを\nそしできるか どうかは\nアナタたち しだいよ",
   "speakers": [
    "SciLabWoman"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    52
   ],
   "uses": 2
  },
  {
   "id": 5620,
   "src": "ワタシには おうえんするしか\nできないから その分 こころを\nこめて いわせてもらうわ",
   "speakers": [
    "SciLabWoman"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    52
   ],
   "uses": 2
  },
  {
   "id": 5621,
   "src": "がんばって!",
   "speakers": [
    "SciLabWoman"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    52
   ],
   "uses": 2
  },
  {
   "id": 5622,
   "src": "・・・コレ もっていってくれ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    53
   ],
   "uses": 2
  },
  {
   "id": 5623,
   "src": "くちべた だから\nうまく いえないけど\nがんばってくれよ・・・",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078D9AC",
    53
   ],
   "uses": 4
  },
  {
   "id": 5624,
   "src": "わたしたちは ここで\nネットワークのかんしを\nしているんだ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    0
   ],
   "uses": 2
  },
  {
   "id": 5625,
   "src": "さいきんは、\nネビュラの かつどうが\nかっぱつになってきたから",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    0
   ],
   "uses": 2
  },
  {
   "id": 5626,
   "src": "いっしゅんも 気がぬけないよ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    0
   ],
   "uses": 2
  },
  {
   "id": 5627,
   "src": "ただモニターを見ているだけに\n見えるかもしれないけど、",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    1
   ],
   "uses": 2
  },
  {
   "id": 5628,
   "src": "ネットワークのかんしは\n24時間 ちゅうやをとわず\nおこなっているから",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    1
   ],
   "uses": 2
  },
  {
   "id": 5629,
   "src": "けっこう、ハードなシゴトなんだ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    1
   ],
   "uses": 2
  },
  {
   "id": 5630,
   "src": "外のこうえんで\nはしっている人が\nいただろ?",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    1
   ],
   "uses": 2
  },
  {
   "id": 5631,
   "src": "時間が あいたら\nあんなふうに 体力づくりも\nしなくちゃ ダメなんだ",
   "speakers": [
    "Scientist"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078DF2C",
    1
   ],
   "uses": 2
  },
  {
   "id": 5632,
   "src": "システム・オールグリーン\n科学省のメインシステムは\nげんざい、せいじょうにさどう中",
