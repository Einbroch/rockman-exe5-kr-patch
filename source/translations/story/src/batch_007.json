    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    15
   ],
   "uses": 2
  },
  {
   "id": 2263,
   "src": "熱斗くん、HPにウイルスが\nはいってるんだよ!\nにげてるばあいじゃないでしょ!",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "075445C",
    13
   ],
   "uses": 4
  },
  {
   "id": 2271,
   "src": "Bボタンで ロックバスター、\nいりょくは よわいけど\nれんしゃができる",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "075445C",
    17
   ],
   "uses": 2
  },
  {
   "id": 2272,
   "src": "さらに ためてからはなせば\nチャージショットが うてるよ",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "075445C",
    17
   ],
   "uses": 2
  },
  {
   "id": 2281,
   "src": "このカスタムゲージは\n時間が たつと\nすこしずつ たまっていって、",
