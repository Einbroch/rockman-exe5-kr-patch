    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "075445C",
    21
   ],
   "uses": 2
  },
  {
   "id": 2315,
   "src": "こんかいは ワイドソードの\nデータも いっしょに\nおくってよ",
