   "uses": 2
  },
  {
   "id": 2331,
   "src": "オペレーティングが\nうまくいっているかどうかを\n見るめやすになるってわけ",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    3
   ],
   "uses": 2
  },
  {
   "id": 2332,
   "src": "さいしょはボクも\nへいじょうしん でいるけど\nダメージを うけつづけたりすると",
