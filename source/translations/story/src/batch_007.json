   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "0755114",
    8
   ],
   "uses": 2
  },
  {
   "id": 2343,
   "src": "そっか てきも攻撃中だから\nメンくらっちゃうわけだな!",
