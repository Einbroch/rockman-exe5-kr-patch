{
 "batch": 7,
 "items": [
  {
   "id": 2192,
   "src": "さて、まずサイショに\nことわっておくべきコトが\nありマス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    0
   ],
   "uses": 2
  },
  {
   "id": 2193,
   "src": "十字ボタンでナビを\nソウサすることはデキマセン!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    0
   ],
   "uses": 2
  },
  {
   "id": 2194,
   "src": "でもアンシンしてくだサイ\nサイショにカンタンなシジを出せば\nナビはかってにうごいてくれマス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    0
   ],
   "uses": 2
  },
  {
   "id": 2195,
   "src": "まずはシジの出し方から\nベンキョウしましょう!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    0
   ],
   "uses": 2
  },
  {
   "id": 2196,
   "src": "これがさくせんがめんデス\nどのてきをねらうか\nきめるワケですネ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    1
   ],
   "uses": 2
  },
  {
   "id": 2197,
   "src": "下にはナビがつかうことのできる\nチップがヒョウジされてイマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    2
   ],
   "uses": 2
  },
  {
   "id": 2198,
   "src": "チップのせいのうをサンコウにして\nさくせんをかんがえるといいデスヨ\nRボタンでセツメイがみれマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    3
   ],
   "uses": 2
  },
  {
   "id": 2199,
   "src": "それじゃジッサイに\nねらうてきをえらんでみまショウ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    3
   ],
   "uses": 2
  },
  {
   "id": 2200,
   "src": "いまはレンシュウなので\nニゲなくてもいいデスヨ!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    4
   ],
   "uses": 2
  },
  {
   "id": 2201,
   "src": "つぎは ねらうてきにたいして\nなんマス分 キョリをとるか\nそのまあいを きめマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    5
   ],
   "uses": 2
  },
  {
   "id": 2202,
   "src": "ナビはなるべくそのまあいに\nなるようにうごいてくれるので",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    5
   ],
   "uses": 2
  },
  {
   "id": 2203,
   "src": "てきウイルスのうごき方や\n攻撃ほうほうにあわせて\nえらぶといいとおもいますヨ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    5
   ],
   "uses": 2
  },
  {
   "id": 2204,
   "src": "それではジッサイに\nまあいをきめてみまショウ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    5
   ],
   "uses": 2
  },
  {
   "id": 2205,
   "src": "それではいよいよ\nバトルのかいしデス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2206,
   "src": "ナビは てきにたいして\nしていしたまあいを\nたもつようにうごきマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2207,
   "src": "チャンスのときはRボタンや\nLボタンでナビに攻撃のシジを\n出しましょう!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2208,
   "src": "バスターのれんしゃだったり\nシールドだったり\nチャージ攻撃だったり",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2209,
   "src": "ナビごとにチガいますので\nごちゅういクダサイ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2210,
   "src": "で カンジンのチップ攻撃の\nやり方ですが それでは\nここにちゅーもくしてクダサイ!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    6
   ],
   "uses": 2
  },
  {
   "id": 2211,
   "src": "これはカスタムゲージという\nものデス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    7
   ],
   "uses": 2
  },
  {
   "id": 2212,
   "src": "このゲージがたまっていないと\nチップはつかえないんデス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    7
   ],
   "uses": 2
  },
  {
   "id": 2213,
   "src": "じかんとともにたまっていき\nあるていどたまるとイロがかわり\nきいろくなりマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    7
   ],
   "uses": 2
  },
  {
   "id": 2214,
   "src": "さらにためればあおく\nさらにマンタンまでためれば\nあかくなっちゃうんデスヨ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    7
   ],
   "uses": 2
  },
  {
   "id": 2215,
   "src": "さいしょはきいろいところまで\nたまったじょうたいから\nスタートします",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    7
   ],
   "uses": 2
  },
  {
   "id": 2216,
   "src": "そして!\nがめんの下の方にちゅーもく\nしてクダサイ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    8
   ],
   "uses": 2
  },
  {
   "id": 2217,
   "src": "これはナビがそうびしている\nフォルダの中のチップです\nまいかいランダムにえらばれます",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    9
   ],
   "uses": 2
  },
  {
   "id": 2218,
   "src": "きいろいのはスタンダードチップ\nカスタムゲージがきいろまで\nたまっていればつかえマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    10
   ],
   "uses": 2
  },
  {
   "id": 2219,
   "src": "あおいのはメガクラスチップ\nカスタムゲージがあおいろまで\nたまっていればつかえマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    11
   ],
   "uses": 2
  },
  {
   "id": 2220,
   "src": "そしていまはでていませんが\nあかいのはギガクラスチップ!\nマンタンのときだけつかえマス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    12
   ],
   "uses": 2
  },
  {
   "id": 2221,
   "src": "ちなみにチップをつかうときは\n十字ボタンの左右でつかいたい\nチップにカーソルをあわせて",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    13
   ],
   "uses": 2
  },
  {
   "id": 2222,
   "src": "Aボタンでナビにおくりマス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    13
   ],
   "uses": 2
  },
  {
   "id": 2223,
   "src": "もしつかいたいチップがないなら\nBボタンをおせば チップを\nシャッフルすることもできマスヨ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    13
   ],
   "uses": 2
  },
  {
   "id": 2224,
   "src": "ただ シャッフルすると\nカスタムゲージがへっちゃいマス\nつかいすぎはキンモツデスヨ",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    13
   ],
   "uses": 2
  },
  {
   "id": 2225,
   "src": "それではジッサイに\nバトルをしてみまショウ!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    14
   ],
   "uses": 2
  },
  {
   "id": 2226,
   "src": "もしバトルがはじまってから\nねらうあいてをかえたいときは\n十字ボタンの上をおしてください",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    14
   ],
   "uses": 2
  },
  {
   "id": 2227,
   "src": "あいてとのまあいを\nかえたいばあいは\n十字ボタンの下をおしてください",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    14
   ],
   "uses": 2
  },
  {
   "id": 2228,
   "src": "それでは\nがんばってクダサイ!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    14
   ],
   "uses": 2
  },
  {
   "id": 2229,
   "src": "ウイルスバスティングこうざ\nしゅうりょうデス",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    15
   ],
   "uses": 2
  },
  {
   "id": 2230,
   "src": "ナビがオートでうごくことに\nさいしょは とまどうかも\nしれませんが・・・",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    15
   ],
   "uses": 2
  },
  {
   "id": 2231,
   "src": "ナビをしんらいして\nオペレーターはチップでのエンゴに\nシュウチュウするのデス!",
   "speakers": [
    "MrProgGold"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0753CD8",
    15
   ],
   "uses": 2
  },
  {
   "id": 2232,
   "src": "それではガンバッテクダサイ!",
