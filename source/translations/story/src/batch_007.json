   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    3
   ],
   "uses": 2
  },
  {
   "id": 2333,
   "src": "とうぜん ボクも ふあんな\nきもちになる・・・",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    3
   ],
   "uses": 2
  },
  {
   "id": 2334,
   "src": "ぎゃくに 熱斗くんのココロが\nボクとつうじあうように\nいきのあったオペレーティングだと",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    4
   ],
   "uses": 2
  },
  {
   "id": 2335,
   "src": "フルシンクロといって、\nボクらのココロが\n1つになったかのような",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    4
   ],
   "uses": 2
  },
  {
   "id": 2336,
   "src": "しゅうちゅうりょくを\nうみだすんだ!",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0755114",
    4
   ],
   "uses": 2
  },
  {
   "id": 2338,
   "src": "それはズバリ\nカウンターをとることだよ",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "0755114",
    6
   ],
   "uses": 2
  },
  {
   "id": 2339,
   "src": "カウンター?\nえーっと・・・なんだっけ?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "0755114",
    7
   ],
   "uses": 2
  },
  {
   "id": 2341,
   "src": "っていうタイミングで\nチップ攻撃をあてることを\nカウンターっていうんだ",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "none"
   ],
   "where": [
    "blues",
    "0755114",
    8
   ],
   "uses": 2
  },
  {
   "id": 2342,
   "src": "ふいをつかれたあいては\nマヒじょうたいになって\nしばらくうごけなくなるよ",
