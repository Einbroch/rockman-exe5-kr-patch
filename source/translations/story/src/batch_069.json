   "id": 12036,
   "src": "そういや、おまえのパパって\nIPCっていう",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    17
   ],
   "uses": 2
  },
  {
   "id": 12037,
   "src": "大きなPETメーカーの\nしゃちょうだったよな",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    17
   ],
   "uses": 2
  },
  {
   "id": 12038,
   "src": "だったら、おまえも\nしょうたい されてるんだろ?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    17
   ],
   "uses": 2
  },
  {
   "id": 12039,
   "src": "「しょうたいけん」も\nあるんだよな?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    17
   ],
   "uses": 2
  },
  {
   "id": 12040,
   "src": "・・・ざんねんだが、\nビッグカンパニーとは\nながねんのライバルがいしゃでな",
   "speakers": [
    "Chaud"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    18
   ],
   "uses": 2
  },
  {
   "id": 12041,
   "src": "IPCは しょうたい\nされていないんだ",
   "speakers": [
    "Chaud"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    18
   ],
   "uses": 2
  },
  {
   "id": 12042,
   "src": "すまないが、じりきで\n手にいれてくれ",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    18
   ],
   "uses": 4
  },
  {
   "id": 12043,
   "src": "えーっ!?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    19
   ],
   "uses": 2
  },
  {
   "id": 12044,
   "src": "そんな、こまるよ\nオレ、世界のトップきぎょうの\nしりあいとか・・・まてよ",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    19
   ],
   "uses": 2
  },
  {
   "id": 12045,
   "src": "そういえば、\n世界のトップきぎょうの\nしりあいが いたな!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    19
   ],
   "uses": 2
  },
  {
   "id": 12046,
   "src": "さっそく ききに行ってみるか\nそれじゃあな、炎山!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    19
   ],
   "uses": 2
  },
  {
   "id": 12047,
   "src": "・・・ロックマンのコトだが、",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    22
   ],
   "uses": 4
  },
  {
   "id": 12048,
   "src": "おそらく このさき\nロックマンは てきとして",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    22
   ],
   "uses": 4
  },
  {
   "id": 12049,
   "src": "オレたちのまえに\nたちはだかるだろう・・・",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    22
   ],
   "uses": 4
  },
  {
   "id": 12050,
   "src": "そのとき、おまえは\n・・・きれるのか?",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    22
   ],
   "uses": 4
  },
  {
   "id": 12051,
   "src": "・・・もしも、ロックマンの\nココロが ぜんぶヤミに\nそまってしまっていたら",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    23
   ],
   "uses": 4
  },
  {
   "id": 12052,
   "src": "・・・そのときは\nオレが ロックマンをたおす",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    23
   ],
   "uses": 4
  },
  {
   "id": 12053,
   "src": "オレが やらなくちゃ\nいけないんだ・・・",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    23
   ],
   "uses": 4
  },
  {
   "id": 12055,
   "src": "オレが カーネルを\nとめたばっかりに、",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    27
   ],
   "uses": 2
  },
  {
   "id": 12056,
   "src": "いや、そのときカーネルが\nロックマンを きっていようが\nきっていまいが、",
   "speakers": [
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BDEA8",
    28
   ],
   "uses": 2
  }
 ]
}
