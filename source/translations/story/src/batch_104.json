  },
  {
   "id": 17601,
   "src": "よっし、リベレートせいこう!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    0
   ],
   "uses": 4
  },
  {
   "id": 17602,
   "src": "かんじは\nつかめてきたようだな",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    1
   ],
   "uses": 4
  },
  {
   "id": 17603,
   "src": "それでは、こんどは\nヤミのあな について\nせつめいする",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    1
   ],
   "uses": 4
  },
  {
   "id": 17604,
   "src": "ヤミのあな?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    2
   ],
   "uses": 4
  },
  {
   "id": 17605,
   "src": "あれを 見てみろ",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    3
   ],
   "uses": 4
  },
  {
   "id": 17606,
   "src": "あれが ヤミのあなだ",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    4
   ],
   "uses": 4
  },
  {
   "id": 17607,
   "src": "すべての ヤミのあなを\nリベレートしないと\nダークロイドとは たたかえないぞ",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    4
   ],
   "uses": 4
  },
  {
   "id": 17608,
   "src": "そばに いるのは ガーディアンだ\nヤミのあなから うまれてくる",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    4
   ],
   "uses": 4
  },
  {
   "id": 17609,
   "src": "つまり やつらがせめてくる前に\nできるだけはやく ヤミのあなを\nリベレートしなきゃってことだな",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    5
   ],
   "uses": 4
  },
  {
   "id": 17610,
   "src": "ガーディアンはじぶんの\nちかくにいる あいてを\n攻撃してくるだろう",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    6
   ],
   "uses": 4
  },
  {
   "id": 17611,
   "src": "そうなると こちらも\n大きくダメージを\nうけてしまう",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    6
   ],
   "uses": 4
  },
  {
   "id": 17612,
   "src": "なるべくダークロイドフェイズに\nなってしまう前に やつらを\nたおしてしまうか",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    6
   ],
   "uses": 4
  },
  {
   "id": 17613,
   "src": "いっきに ヤミのあなを\nリベレートしてしまうか\nどちらかだな",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    6
   ],
   "uses": 4
  },
  {
   "id": 17614,
   "src": "なるほど、とにかく\nやってみるか!\nいくぜ!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F2E0C",
    7
   ],
   "uses": 4
  },
  {
   "id": 17615,
   "src": "ふむ、みごとだ\nかなり なれてきたようだな",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    0
   ],
   "uses": 4
  },
  {
   "id": 17616,
   "src": "ああ、かなりわかってきたぜ!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    1
   ],
   "uses": 4
  },
  {
   "id": 17617,
   "src": "もし ナビのHPが少なくなったら\nむりに リベレートせず\n「なにもしない」をえらぶといい",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    1
   ],
   "uses": 4
  },
  {
   "id": 17618,
   "src": "1回やすむことには なるが\nHPが あるていどだけ\nかいふくするぞ",
   "speakers": [
    "ProtoMan",
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    1
   ],
   "uses": 4
  },
  {
   "id": 17619,
   "src": "なるほど\nりょうかいだぜ",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    1
   ],
   "uses": 4
  },
  {
   "id": 17620,
   "src": "なあ、ブルース",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    2
   ],
   "uses": 2
  },
  {
   "id": 17621,
   "src": "あの「?」ってかいてある\nパネルは なんだ?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    2
   ],
   "uses": 4
  },
  {
   "id": 17622,
   "src": "はじめてみるものだが\nあれは おそらく\nボーナスパネルとよばれるものだ",
   "speakers": [
    "ProtoMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07F3218",
    3
   ],
   "uses": 2
  }
 ]
}
