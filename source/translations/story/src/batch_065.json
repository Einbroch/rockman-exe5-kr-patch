    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    3
   ],
   "uses": 2
  },
  {
   "id": 11422,
   "src": "あのナビは ネビュラのナビじゃ\nないみたいだね・・・",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    3
   ],
   "uses": 2
  },
  {
   "id": 11423,
   "src": "あのナビって、アナタたちの\nところにもきたの?",
   "speakers": [
    "Tesla"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    4
   ],
   "uses": 2
  },
  {
   "id": 11424,
   "src": "アイツらは なにが\nもくてきなんだ・・・?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    5
   ],
   "uses": 4
  },
  {
   "id": 11425,
   "src": "たしかに 気になるけど、\nとりあえず今は マグネットマンの\nプログラムを さがしに行こうよ",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    6
   ],
   "uses": 2
  },
  {
   "id": 11426,
   "src": "そうだな、かんがえるのは\nあとにしよう・・・",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    7
   ],
   "uses": 4
  },
  {
   "id": 11427,
   "src": "それじゃ、テスラさん\n行ってくるよ!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    7
   ],
   "uses": 2
  },
  {
   "id": 11428,
   "src": "熱斗くん・・・\nよろしくおねがいね!",
   "speakers": [
    "Tesla"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    8
   ],
   "uses": 2
  },
  {
   "id": 11430,
   "src": "プライド!\nナイトマンは!?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    11
   ],
   "uses": 2
  },
  {
   "id": 11431,
   "src": "熱斗、きてくれたのですね!",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11432,
   "src": "メールにもかいたとおり、\nニンジャの かっこうをした\nナビに、",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11433,
   "src": "ナイトマンの しこう、げんご、\nいどう、こうげきのプログラムを\nうばわれてしまいました・・・",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11434,
   "src": "そして、そのプログラムを\nさくがんきの電脳の中に\nバラまかれてしまったんです",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11435,
   "src": "おかげで ナイトマンは\nかんがえられない、はなせない\nうごけない、こうげきできない",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11436,
   "src": "デリートすんぜんの\nじょうたいです・・・",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    12
   ],
   "uses": 2
  },
  {
   "id": 11437,
   "src": "だけど、ナイトマンを\nデリートしなかったところを\n見ると、",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    14
   ],
   "uses": 2
  },
  {
   "id": 11438,
   "src": "シャドーマンは ネビュラじゃ\nないみたいだね・・・",
   "speakers": [
    "MegaMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    14
   ],
   "uses": 2
  },
  {
   "id": 11439,
   "src": "シャドーマンって・・・\nあのナビが シャドーマン\nだったのですか?",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    15
   ],
   "uses": 2
  },
  {
   "id": 11440,
   "src": "そうか、シャドーマンも\nいぜん、ゴスペルのいちいん\nだったな・・・",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    16
   ],
   "uses": 2
  },
  {
   "id": 11441,
   "src": "けど、プライドが\nシャドーマンをしらないなんて、\nいがいだな",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    16
   ],
   "uses": 2
  },
  {
   "id": 11442,
   "src": "えぇ・・・",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07BA4B8",
    17
   ],
   "uses": 2
  },
  {
   "id": 11443,
   "src": "シャドーマンは、せいしきな\nゴスペルの だんいんではなく、",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
