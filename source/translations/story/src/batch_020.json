   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "0785B5C",
    11
   ],
   "uses": 2
  },
  {
   "id": 4550,
   "src": "ネットナビが シゴトを\nしてくれないと、メールチェックも\nできないから たいへんだよ",
   "speakers": [
