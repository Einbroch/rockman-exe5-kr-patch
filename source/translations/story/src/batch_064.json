   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07B91FC",
    15
   ],
   "uses": 2
  },
  {
   "id": 11282,
   "src": "この世の おわりと\nいっていいだろう・・・",
   "speakers": [
    "Dusk"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07B91FC",
    15
   ],
   "uses": 2
  },
  {
   "id": 11284,
   "src": "アイツは てきなのか・・・\nみかたなのか・・・?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07B91FC",
    17
   ],
   "uses": 2
  },
  {
   "id": 11285,
   "src": "それに パパのもってる\n「あるもの」ってなんだ?",
   "speakers": [
