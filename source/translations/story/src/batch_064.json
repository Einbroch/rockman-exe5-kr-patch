   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07B91FC",
    17
   ],
   "uses": 2
  },
  {
   "id": 11287,
   "src": "炎山くんからだ・・・\nよんでみるよ!!",
