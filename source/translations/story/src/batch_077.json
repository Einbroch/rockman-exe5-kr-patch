   "src": "こういうときこそ、\nいちど ひといきいれて",
   "speakers": [
    "NumberMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    27
   ],
   "uses": 2
  },
  {
   "id": 13266,
   "src": "たいせいを たてなおすべきかと\nおもうのですが・・・",
   "speakers": [
    "NumberMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    27
   ],
   "uses": 2
  },
  {
   "id": 13267,
   "src": "どうした、\nウラインターネットと きいて\nおじけづいたのか!?",
   "speakers": [
    "TomahawkMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    28
   ],
   "uses": 2
  },
  {
   "id": 13268,
   "src": "・・・いや、\nナンバーマンの いうとおりだ",
   "speakers": [
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    29
   ],
   "uses": 2
  },
  {
   "id": 13269,
   "src": "今のネビュラは いわば、\nておいの やじゅう・・・",
   "speakers": [
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    31
   ],
   "uses": 2
  },
  {
   "id": 13270,
   "src": "それに、われわれも\nむきずでは ないからな・・・",
   "speakers": [
    "Colonel"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    31
   ],
   "uses": 2
  },
  {
   "id": 13271,
   "src": "そ、それとですね・・・\nあのウラインターネットへの\nみちをふさぐ そのトビラ、",
   "speakers": [
    "NumberMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    32
   ],
   "uses": 2
  },
  {
   "id": 13272,
   "src": "かんたんには ひらかない\nでしょうからね・・・",
   "speakers": [
    "NumberMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    32
   ],
   "uses": 2
  },
  {
   "id": 13273,
   "src": "ちょっとまたれい、\nほんとうに そのトビラが\nひらかぬモノなのか",
   "speakers": [
    "KnightMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    34
   ],
   "uses": 2
  },
  {
   "id": 13274,
   "src": "たしかめさせては\nもらえんか?",
   "speakers": [
    "KnightMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    34
   ],
   "uses": 2
  },
  {
   "id": 13275,
   "src": "ナイトとして、\nおいつめた てきに せを\nむけるのは なっとくがいかん",
   "speakers": [
    "KnightMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C5F1C",
    34
   ],
   "uses": 2
  },
  {
   "id": 13276,
   "src": "・・・すきにしろ",
