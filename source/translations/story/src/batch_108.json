    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "colonel",
    "0756A08",
    2
   ],
   "uses": 1
  },
  {
   "id": 18120,
   "src": "つまりエアホッケーなどの\nブレイク系の チップを\nいけにえにすればユニゾンできる",
