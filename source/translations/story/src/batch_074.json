   "id": 12801,
   "src": "世界トップクラスの\n科学者のコンピュータを\nのぞくことができたんだからな!",
   "speakers": [
    "Raika"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    16
   ],
   "uses": 2
  },
  {
   "id": 12802,
   "src": "あぁ、時間とらせて\nわるかったな",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    17
   ],
   "uses": 2
  },
  {
   "id": 12803,
   "src": "おまえ、ネビュラのナビを\nおいかけてるんだろ?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    17
   ],
   "uses": 2
  },
  {
   "id": 12804,
   "src": "そうさに もどらなくて\nだいじょうぶなのか?",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    17
   ],
   "uses": 2
  },
  {
   "id": 12805,
   "src": "・・・あ、あぁ、そうだったな",
   "speakers": [
    "Raika"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    18
   ],
   "uses": 2
  },
  {
   "id": 12806,
   "src": "それじゃあ、オレはこのへんで\nシツレイさせてもらうよ・・・",
   "speakers": [
    "Raika"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    18
   ],
   "uses": 2
  },
  {
   "id": 12807,
   "src": "じゃあな!",
   "speakers": [
    "Raika"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    18
   ],
   "uses": 2
  },
  {
   "id": 12808,
   "src": "あっ、きたきた!!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    19
   ],
   "uses": 2
  },
  {
   "id": 12809,
   "src": "日暮さーん!\nこっちに はいってきてよ!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    19
   ],
   "uses": 2
  },
  {
   "id": 12810,
   "src": "日暮さん、このコンピュータ\nなんだけどさ・・・",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    20
   ],
   "uses": 2
  },
  {
   "id": 12811,
   "src": "そのまえに 1つかくにん\nしておきたいでマッスが、",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    21
   ],
   "uses": 2
  },
  {
   "id": 12812,
   "src": "ここは 熱斗くんの パパの\nけんきゅう室・・・",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    21
   ],
   "uses": 2
  },
  {
   "id": 12813,
   "src": "つまり、ニホンでも\nトップシークレットのへやでマッス",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    21
   ],
   "uses": 2
  },
  {
   "id": 12814,
   "src": "そこに アッシのような\nチップショップのてんちょうを\nいれても いいんでマッスか?",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    21
   ],
   "uses": 2
  },
  {
   "id": 12815,
   "src": "なにいってんのさ、\nオレたちは おなじもくてきを\nもったチームメイトじゃんか!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    22
   ],
   "uses": 2
  },
  {
   "id": 12816,
   "src": "そんなことよりさ、\nはやく セキュリティを\nかいじょしてよ!",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    22
   ],
   "uses": 2
  },
  {
   "id": 12817,
   "src": "チームメイトでマッスか・・・\nヌフフ!",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    23
   ],
   "uses": 2
  },
  {
   "id": 12818,
   "src": "わかったでマッス、\nそれでは セキュリティを\nかいじょするでマッス",
   "speakers": [
    "Higsby"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07C2DCC",
    23
   ],
   "uses": 2
  }
 ]
}
