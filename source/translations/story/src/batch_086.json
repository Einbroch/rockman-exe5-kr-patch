    "Dusk"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    24
   ],
   "uses": 2
  },
  {
   "id": 14647,
   "src": "よかった・・・",
   "speakers": [
    "Ribitta"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    26
   ],
   "uses": 2
  },
  {
   "id": 14648,
   "src": "ってコトは ネビュラの\nほんきょちに のりこむのは\nカーネルが かいふくしてからだな",
   "speakers": [
    "Lan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    27
   ],
   "uses": 2
  },
  {
   "id": 14649,
   "src": "リーダーがいないと\nしまらないからね!",
   "speakers": [
    "Lan"
   ],
   "windows": [
