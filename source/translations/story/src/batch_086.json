   "id": 14636,
   "src": "いじょうだ・・・\nかいさん!",
   "speakers": [
    "Chaud",
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    15
   ],
   "uses": 4
  },
  {
   "id": 14637,
   "src": "もう、みんな しっているかと\nおもうが、カーネルが\nかえってきた・・・",
   "speakers": [
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    16
   ],
   "uses": 2
  },
  {
   "id": 14638,
   "src": "それじゃぁ さっそく\nネビュラの ほんきょちを\nたたきに 行こうぜ!",
   "speakers": [
    "Dingo"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    17
   ],
   "uses": 2
  },
  {
   "id": 14639,
   "src": "てきの ほんきょちが\nどこにあるのかも\nわからないのに",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    18
   ],
   "uses": 2
  },
  {
   "id": 14640,
   "src": "せめようが ありませんわ",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    18
   ],
   "uses": 2
  },
  {
   "id": 14641,
   "src": "そ、それも そうだな・・・",
   "speakers": [
    "Dingo"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    19
   ],
   "uses": 2
  },
  {
   "id": 14642,
   "src": "いや、ネビュラのほんきょちの\nメボシは おおかたついている",
   "speakers": [
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    20
   ],
   "uses": 2
  },
  {
   "id": 14643,
   "src": "ほんとうですの?",
   "speakers": [
    "Pride"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    21
   ],
   "uses": 2
  },
  {
   "id": 14644,
   "src": "あぁ、カーネルの アクセスログに\nネビュラの きょてんと\nおもわれる ばしょがあった",
   "speakers": [
    "Baryl"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    22
   ],
   "uses": 2
  },
  {
   "id": 14645,
   "src": "じゃあ、すぐにでも\n行けるじゃないか!!",
   "speakers": [
    "Dingo"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "07CEAE8",
    23
   ],
   "uses": 2
  },
  {
   "id": 14646,
   "src": "で、どうなんだ・・・\nカーネルの ようだいは?",
