   ],
   "where": [
    "blues",
    "078A404",
    40
   ],
   "uses": 2
  },
  {
   "id": 5166,
   "src": "イヤー、アツい アツい!\nこういう時は ぜいたくに\nタクシーで いどうといきたいが",
   "speakers": [
    "BusinessMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078A404",
    41
   ],
   "uses": 2
  },
  {
   "id": 5167,
   "src": "さっきから ぜんぜんタクシーが\nこないんだよ",
