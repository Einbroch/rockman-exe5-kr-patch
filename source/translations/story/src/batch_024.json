    "YoungWoman"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078A404",
    40
   ],
   "uses": 2
  },
  {
   "id": 5164,
   "src": "いいなー!\nおねえさんも つれてってー!",
