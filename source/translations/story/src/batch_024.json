    "BusinessMan"
   ],
   "windows": [
    "msgOpen"
   ],
   "where": [
    "blues",
    "078A404",
    41
   ],
   "uses": 2
  },
  {
   "id": 5168,
   "src": "やぁっ!\nエリアスチール!",
